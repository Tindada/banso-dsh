# Relative paths are resolved against evaluation/.
EVAL_DSH_BIN=/absolute/path/to/node_modules/.bin/dsh
EVAL_DSH_HOME=/absolute/path/to/dsh-home
EVAL_DSH_PROFILE=banso-dsh
EVAL_DSH_MODEL=deepseek-flash
EVAL_DSH_REASONING_EFFORT=high
# Optional override: extract for evidence, direct for saved page text.
# Omit to follow the DSH environment and YAML defaults.
# BANSO_WEB_READ_MODE=direct

DEEPSEEK_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=
