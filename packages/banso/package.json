{
  "name": "banso-dsh",
  "version": "0.1.0",
  "description": "Banso research bundle for DeepSeek Harness",
  "scripts": {
    "build": "node scripts/copy-base-patch.mjs",
    "prepack": "node scripts/copy-base-patch.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "banso-dsh-base": "workspace:*",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.0-rc.2",
    "banso-dsh-web-search-tavily": "workspace:*",
    "banso-dsh-prompt": "workspace:*",
    "banso-dsh-materials": "workspace:*",
    "banso-dsh-tool-web": "workspace:*"
  },
  "files": [
    "base.patch.yml",
    "cordis.patch.yml",
    "scripts/copy-base-patch.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./base.patch.yml",
        "./cordis.patch.yml"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2"
  }
