{
  "name": "banso-dsh-web-fetch-fallback",
  "version": "0.1.3",
  "description": "Composite fetch provider with DeepSeek Fetch API primary and Jina Reader fallback for DeepSeek Harness",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "type": "module",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "banso-dsh-web-fetch-jina": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-deepseek-account": "0.2.2-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-web": "0.2.2-rc.5",
    "@deepseek-ai/dsh-web-deepseek-api": "0.2.2-rc.5",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-deepseek-account": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-web": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-web-deepseek-api": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-deepseek-account": {
      "optional": true
    }
  }
}
